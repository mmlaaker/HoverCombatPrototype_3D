  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5aac5b435c1f08d46b43aaecdf2a69ea, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PlaytestSession
  sessionLength: 600
  controlsUnlockTime: 120
  showClock: 1
  overlayButton: 12
  overlayKey: 3
  restartKey: 30
  restartHoldSeconds: 1
  splashText: "HOVER COMBAT PROTOTYPE\n\nPRE-ALPHA 1: MOVEMENT PLAYTEST\n\nVoice
    your thoughts out loud as they come to you, \nincluding the boring, annoying
    or confusing parts.\n\nHold SHARE to reset your hover craft.\n\nPress OPTIONS
    to begin."
  controlsText: 'CONTROLS


    Left Stick (Y)       Throttle and reverse

    Right
    Stick (X)     Steer

    Right Stick (Y)     Camera Pitch (Drive) -- Aim (Strafe)


    X                         
    Jump (Grounded, Tap or Hold to Charge) -- Double Jump (Airborne)


    L1/R1
    (Hold)        Drift (Grounded) -- Pitch/Roll (Airborne)

    L2 (Hold)            
    Aim/Strafe Mode

    R2                        Fire Machine Guns


    L3                       
    Boost -- Side Dodge (Strafing)


    SHARE (hold)      Reset


    OPTIONS            
    CLOSE MENU'
  font: {fileID: 0}
